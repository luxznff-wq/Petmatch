# ============================================================================
# PetMatch · Variables de entorno
# Copia este archivo como .env y ajusta los valores. NUNCA subas .env a Git.
# ============================================================================

# --- Base de datos --------------------------------------------------------
# Cadena de conexión de PostgreSQL. Si se deja vacía, la API arranca en modo
# memoria con datos de demostración (útil para probar sin instalar Postgres).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/petmatch

# --- Backend --------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Secreto para firmar los JWT. En producción usa un valor largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Coste del hash de contraseñas (bcrypt). 12 es un buen equilibrio.
BCRYPT_ROUNDS=12

# Origen autorizado para CORS: la URL del frontend.
FRONTEND_URL=http://localhost:5173

# URL pública de la API; aparece en la documentación Swagger.
API_URL=http://localhost:4000/api

# --- Datos de demostración (npm run db:seed) ------------------------------
SEED_ADMIN_EMAIL=admin@petmatch.com
SEED_ADMIN_PASSWORD=Admin123
SEED_DEMO_PASSWORD=Demo1234

# --- Frontend -------------------------------------------------------------
# En desarrollo puede quedar vacía: Vite hace proxy de /api al backend.
# En producción apunta al dominio de la API, por ejemplo:
#   VITE_API_URL=https://petmatch-api.onrender.com/api
VITE_API_URL=

# --- Correo transaccional -------------------------------------------------
# Sin SMTP_HOST los mensajes se imprimen en la consola en lugar de enviarse:
# la recuperación de contraseña funciona en local sin contratar un proveedor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PetMatch <no-reply@petmatch.example>

# --- Subida de fotografías ------------------------------------------------
# Directorio donde se guardan los archivos. En plataformas con disco efímero
# (Render) debe apuntar a un volumen persistente o usarse almacenamiento de
# objetos.
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880

# --- Límites de peticiones ------------------------------------------------
# Sin Redis cada instancia cuenta por su lado: obligatorio si escalas a más
# de una.
REDIS_URL=

# --- Datos del responsable legal ------------------------------------------
# Aparecen en los Términos y en la Política de Privacidad. OBLIGATORIO
# completarlos antes de publicar la plataforma.
LEGAL_ORGANIZATION=
LEGAL_CONTACT_EMAIL=
LEGAL_ADDRESS=
LEGAL_COUNTRY=Perú
